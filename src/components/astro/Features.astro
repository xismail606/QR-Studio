---
---
<section id="features" class="py-20 md:py-28 lg:py-32 reveal-init">
  <div class="mx-auto max-w-page px-4 sm:px-6">
    <!-- Section Header (No numbered eyebrow) -->
    <div class="max-w-xl mb-14 text-left">
      <h2 data-i18n="home.featuresTitle" class="text-heading-xl font-display font-semibold tracking-tight text-[var(--color-text)] mb-3">
        Engineered for design precision
      </h2>
      <p data-i18n="home.featuresDesc" class="text-body text-[var(--color-text-secondary)] leading-relaxed">
        Every curve, dot, margin, and contrast curve is calculated to remain 100% scannable while matching your brand identity.
      </p>
    </div>

    <!-- Asymmetric Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Bento Item 1: Parametric Geometry (2 cols wide) -->
      <div class="md:col-span-2 double-bezel group">
        <div class="double-bezel-inner p-5 sm:p-6 md:p-8 flex flex-col justify-between h-full relative overflow-hidden">
          <div class="relative z-10">
            <h3 data-i18n="home.moduleTitle" class="text-heading-md font-display font-semibold text-[var(--color-text)] mb-2">
              Parametric Module Architecture
            </h3>
            <p data-i18n="home.moduleDesc" class="text-body-sm text-[var(--color-text-secondary)] max-w-lg leading-relaxed">
              Break away from harsh square grids. Select from fluid radial dots, continuous rounded squircles, or technical asymmetric cuts with independent outer-eye curvature.
            </p>
          </div>

          <!-- Interactive Module Showcase -->
          <div class="mt-8 pt-6 border-t border-[var(--color-border)] grid grid-cols-2 sm:grid-cols-2 md:grid-cols-2 lg:grid-cols-4 gap-2.5 sm:gap-3">
            <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-panel)] p-3 sm:p-4 text-center transition-all duration-300 hover:border-[var(--color-accent)] hover:-translate-y-0.5">
              <div class="mx-auto w-10 h-10 mb-2.5 flex items-center justify-center">
                <div class="w-7 h-7 rounded-full bg-[var(--color-accent)]"></div>
              </div>
              <p data-i18n="home.radial" class="font-mono text-xs font-semibold text-[var(--color-text)]">Radial</p>
              <p data-i18n="home.radialDesc" class="text-caption text-[var(--color-text-muted)] mt-0.5">Fluid circular dots</p>
            </div>

            <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-panel)] p-3 sm:p-4 text-center transition-all duration-300 hover:border-[var(--color-accent)] hover:-translate-y-0.5">
              <div class="mx-auto w-10 h-10 mb-2.5 flex items-center justify-center">
                <div class="w-7 h-7 rounded-lg bg-[var(--color-accent)]"></div>
              </div>
              <p data-i18n="home.squircle" class="font-mono text-xs font-semibold text-[var(--color-text)]">Squircle</p>
              <p data-i18n="home.squircleDesc" class="text-caption text-[var(--color-text-muted)] mt-0.5">Smooth continuous arc</p>
            </div>

            <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-panel)] p-3 sm:p-4 text-center transition-all duration-300 hover:border-[var(--color-accent)] hover:-translate-y-0.5">
              <div class="mx-auto w-10 h-10 mb-2.5 flex items-center justify-center">
                <div class="w-7 h-7 bg-[var(--color-accent)] rounded-tl-xl rounded-br-xl"></div>
              </div>
              <p data-i18n="home.classy" class="font-mono text-xs font-semibold text-[var(--color-text)]">Classy</p>
              <p data-i18n="home.classyDesc" class="text-caption text-[var(--color-text-muted)] mt-0.5">Diagonal organic cut</p>
            </div>

            <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-panel)] p-3 sm:p-4 text-center transition-all duration-300 hover:border-[var(--color-accent)] hover:-translate-y-0.5">
              <div class="mx-auto w-10 h-10 mb-2.5 flex items-center justify-center">
                <div class="w-7 h-7 bg-[var(--color-text)]"></div>
              </div>
              <p data-i18n="home.matrix" class="font-mono text-xs font-semibold text-[var(--color-text)]">Matrix</p>
              <p data-i18n="home.matrixDesc" class="text-caption text-[var(--color-text-muted)] mt-0.5">Sharp technical grid</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Bento Item 2: Readability Guard (1 col wide) -->
      <div class="double-bezel">
        <div class="double-bezel-inner p-5 sm:p-6 md:p-8 flex flex-col justify-between h-full">
          <div>
            <h3 data-i18n="home.readabilityTitle" class="text-heading-md font-display font-semibold text-[var(--color-text)] mb-2">
              Readability Guard
            </h3>
            <p data-i18n="home.readabilityDesc" class="text-body-sm text-[var(--color-text-secondary)] leading-relaxed">
              Live scanner emulation audits contrast curves, module occlusion, and ISO safe-zones before you send files to print.
            </p>
          </div>

          <!-- ISO Audit Panel -->
          <div class="mt-8 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-panel)] p-4 sm:p-5">
            <div class="flex items-center justify-between mb-3">
              <span class="font-mono text-xs text-[var(--color-text-muted)]">ISO/IEC 18004</span>
              <span data-i18n="home.pass" class="font-mono text-[11px] font-semibold text-[var(--color-success)] bg-[var(--color-success)]/10 px-2 py-0.5 rounded-md">PASS</span>
            </div>
            <div class="h-1.5 w-full rounded-full bg-[var(--color-border)] overflow-hidden">
              <div class="h-full w-full rounded-full bg-[var(--color-success)]"></div>
            </div>
            <div class="mt-3.5 flex items-center justify-between font-mono text-[11px] text-[var(--color-text-muted)]">
              <span data-i18n="home.wcag">WCAG AAA Verified</span>
              <span data-i18n="home.margin">4-Module Margin</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Bento Item 3: Smart Logo Placement (1 col wide) -->
      <div class="double-bezel">
        <div class="double-bezel-inner p-5 sm:p-6 md:p-8 flex flex-col justify-between h-full">
          <div>
            <h3 data-i18n="home.logoTitle" class="text-heading-md font-display font-semibold text-[var(--color-text)] mb-2">
              Smart Logo Placement
            </h3>
            <p data-i18n="home.logoDesc" class="text-body-sm text-[var(--color-text-secondary)] leading-relaxed">
              Embed brand glyphs and icons without breaking scannability. Automatic Level H error correction recovers up to 30% occluded matrix data.
            </p>
          </div>

          <!-- Brand Emblem Showcase -->
          <div class="mt-8 flex items-center justify-center p-6 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-panel)]">
            <div class="relative w-18 h-18 rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-card)] p-3 shadow-md flex items-center justify-center">
              <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-[var(--color-accent)] to-[var(--color-accent-hover)] flex items-center justify-center text-white font-mono font-bold text-xs shadow-sm">
                QR
              </div>
              <span class="absolute -bottom-2 -right-2 font-mono text-[10px] font-semibold text-[var(--color-accent)] bg-[var(--color-bg-panel)] px-2 py-0.5 rounded-full border border-[var(--color-border)] shadow-xs">
                Level H
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Bento Item 4: Direct Vector Synthesis (2 cols wide) -->
      <div class="md:col-span-2 double-bezel">
        <div class="double-bezel-inner p-5 sm:p-6 md:p-8 flex flex-col justify-between h-full">
          <div>
            <h3 data-i18n="home.vectorTitle" class="text-heading-md font-display font-semibold text-[var(--color-text)] mb-2">
              Direct Vector Synthesis
            </h3>
            <p data-i18n="home.vectorDesc" class="text-body-sm text-[var(--color-text-secondary)] max-w-lg leading-relaxed">
              Exports produce clean, compound SVG vector paths with zero duplicate geometry or rendering artifacts. Scale to building-size vinyl prints without loss of fidelity.
            </p>
          </div>

          <!-- Format Spec Row -->
          <div class="mt-8 pt-6 border-t border-[var(--color-border)] grid grid-cols-2 sm:grid-cols-2 md:grid-cols-2 lg:grid-cols-4 gap-2.5 sm:gap-3">
            <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-panel)] p-3 sm:p-3.5">
              <span class="font-mono text-xs font-bold text-[var(--color-accent)] block">SVG</span>
              <span data-i18n="home.compoundPaths" class="text-caption text-[var(--color-text-muted)] mt-0.5 block">Compound vector paths</span>
            </div>
            <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-panel)] p-3 sm:p-3.5">
              <span class="font-mono text-xs font-bold text-[var(--color-text)] block">PNG</span>
              <span data-i18n="home.losslessRaster" class="text-caption text-[var(--color-text-muted)] mt-0.5 block">Lossless 4K raster</span>
            </div>
            <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-panel)] p-3 sm:p-3.5">
              <span class="font-mono text-xs font-bold text-[var(--color-text)] block">WEBP</span>
              <span data-i18n="home.webCompression" class="text-caption text-[var(--color-text-muted)] mt-0.5 block">Modern web compression</span>
            </div>
            <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-panel)] p-3 sm:p-3.5">
              <span class="font-mono text-xs font-bold text-[var(--color-text)] block">JPG</span>
              <span data-i18n="home.printProof" class="text-caption text-[var(--color-text-muted)] mt-0.5 block">Flattened print proof</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
