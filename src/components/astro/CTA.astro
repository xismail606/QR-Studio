---
---
<section class="py-20 md:py-28 lg:py-32 border-t border-[var(--color-border)] relative overflow-hidden reveal-init">
  <div class="mx-auto max-w-page px-4 sm:px-6">
    <!-- Centered Manifesto Card with Double-Bezel Architecture -->
    <div class="double-bezel relative overflow-hidden">
      <!-- Subtle ambient glow -->
      <div class="pointer-events-none absolute inset-0 ambient-hero opacity-60"></div>

      <div class="double-bezel-inner p-6 sm:p-10 md:p-14 lg:p-20 text-center relative z-10">
        <div class="mx-auto max-w-2xl">
          <h2 class="text-2xl sm:text-heading-xl md:text-display font-display font-semibold tracking-tight text-[var(--color-text)] mb-4 sm:mb-5" data-i18n="cta.title">
            Your brand deserves better than standard pixel grids
          </h2>
          <p class="text-base sm:text-body-lg text-[var(--color-text-secondary)] mb-8 sm:mb-10 max-w-xl mx-auto leading-relaxed" data-i18n="cta.subtitle">
            Open the studio, customize your geometry, verify scannability in real time, and export production-ready vector assets in seconds.
          </p>

          <!-- Clean direct CTA button -->
          <div class="flex items-center justify-center mb-6 sm:mb-8">
            <a
              href="/generator"
              class="inline-flex items-center gap-2 rounded-full bg-[var(--color-accent)] hover:bg-[var(--color-accent-hover)] text-white px-7 py-3 text-sm font-semibold shadow-lg shadow-[var(--color-accent)]/20 transition-all hover:scale-[1.02] active:scale-[0.98] btn-tactile"
            >
              <span data-i18n="cta.openStudio">Launch Studio</span>
              <svg class="w-4 h-4 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
              </svg>
            </a>
          </div>

          <!-- Clean feature pills without middle-dot overuse -->
          <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 text-xs font-mono text-[var(--color-text-muted)]">
            <span class="bg-[var(--color-bg-panel)] px-2.5 py-1 rounded-md border border-[var(--color-border-subtle)]" data-i18n="cta.clientSide">
              Client-Side Processing
            </span>
            <span class="bg-[var(--color-bg-panel)] px-2.5 py-1 rounded-md border border-[var(--color-border-subtle)]" data-i18n="cta.infiniteVector">
              Infinite Vector SVG
            </span>
            <span class="bg-[var(--color-bg-panel)] px-2.5 py-1 rounded-md border border-[var(--color-border-subtle)]" data-i18n="cta.zeroTelemetry">
              Zero Telemetry
            </span>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>
