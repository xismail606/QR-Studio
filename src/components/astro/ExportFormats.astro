---
const secondaryFormats = [
  {
    ext: 'PNG',
    titleKey: 'home.lossless4k',
    descKey: 'home.lossless4kDesc',
    densityKey: 'home.resolution4k',
    badgeKey: 'home.raster',
    title: 'Lossless 4K Raster',
    desc: '32-bit RGBA with full alpha transparency channel. Ideal for digital pitch decks, UI designs, and social assets.',
    density: 'Up to 4096 × 4096 px',
    badge: 'Raster',
  },
  {
    ext: 'WEBP',
    titleKey: 'home.nextGen',
    descKey: 'home.nextGenDesc',
    densityKey: 'home.lightweightDelivery',
    badgeKey: 'home.optimized',
    title: 'Next-Gen Web Image',
    desc: 'Up to 30% smaller footprint than standard PNG while preserving crisp edges and transparency on high-DPI displays.',
    density: 'Lightweight Web Delivery',
    badge: 'Optimized',
  },
  {
    ext: 'JPG',
    titleKey: 'home.standardProof',
    descKey: 'home.standardProofDesc',
    densityKey: 'home.printProofResolution',
    badgeKey: 'home.solidFill',
    title: 'Standard CMYK Proof',
    desc: 'Solid-background flattened high-density raster designed for quick print proofs and document integration.',
    density: 'High-Density Print Proof',
    badge: 'Solid Fill',
  },
];
---
<section id="export" class="py-20 md:py-28 lg:py-32 border-t border-[var(--color-border)] bg-[var(--color-bg-panel)]/30 reveal-init">
  <div class="mx-auto max-w-page px-4 sm:px-6">
    <div class="max-w-xl mb-14 text-left">
      <h2 data-i18n="home.exportTitle" class="text-heading-xl font-display font-semibold tracking-tight text-[var(--color-text)] mb-3">
        Engineered for any production pipeline
      </h2>
      <p data-i18n="home.exportDesc" class="text-body text-[var(--color-text-secondary)] leading-relaxed">
        Whether etching a building-scale architectural facade or rendering in an iOS application icon, export with exact mathematical fidelity.
      </p>
    </div>

    <!-- Featured Highlight + Pills Layout -->
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] lg:gap-10 items-stretch">
      <!-- Left: Featured Highlight (SVG Vector) -->
      <div class="double-bezel h-full">
        <div class="double-bezel-inner p-5 sm:p-8 md:p-10 flex flex-col justify-between h-full">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="inline-flex items-center gap-1.5 rounded-md bg-[var(--color-accent)] px-3 py-1 font-mono text-xs font-bold text-white shadow-xs">
                SVG
              </span>
              <span class="font-mono text-[11px] font-semibold text-[var(--color-accent)]">
                <span data-i18n="home.recommendedPrint">Recommended for Print</span>
              </span>
            </div>

            <h3 class="text-heading-lg font-display font-semibold text-[var(--color-text)] mb-3">
              <span data-i18n="home.infinitePaths">Infinite Vector Paths</span>
            </h3>
            <p class="text-body-sm text-[var(--color-text-secondary)] leading-relaxed mb-6">
              <span data-i18n="home.infinitePathsDesc">SVG exports construct consolidated compound vector paths rather than thousand separate rect nodes. Ready for direct handoff to Illustrator, Figma, vinyl plotters, and laser cutters.</span>
            </p>

            <!-- Vector Path Blueprint Specimen -->
            <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-panel)] p-4 sm:p-5 font-mono text-xs text-[var(--color-text-secondary)] space-y-2.5">
              <div class="flex items-center justify-between text-[11px] pb-2 border-b border-[var(--color-border-subtle)] text-[var(--color-text-muted)]">
                <span data-i18n="home.outputFormat">Output Format: Scalable Vector Graphics 1.1</span>
                <span>DPI: &infin;</span>
              </div>
              <div class="flex justify-between">
                <span data-i18n="home.pathCompression" class="text-[var(--color-text-muted)]">Path Compression:</span>
                <span data-i18n="home.singlePath" class="text-[var(--color-text)] font-medium">Compound single-path</span>
              </div>
              <div class="flex justify-between">
                <span data-i18n="home.scalingArtifacts" class="text-[var(--color-text-muted)]">Scaling Artifacts:</span>
                <span data-i18n="home.noBlur" class="text-[var(--color-success)] font-medium">Zero rasterization blur</span>
              </div>
              <div class="flex justify-between">
                <span data-i18n="home.colorModel" class="text-[var(--color-text-muted)]">Color Model:</span>
                <span data-i18n="home.rgbHex" class="text-[var(--color-text)] font-medium">RGB + Hex Colorway</span>
              </div>
            </div>
          </div>

          <div class="mt-8 pt-5 border-t border-[var(--color-border)] flex items-center justify-between">
            <span class="text-caption text-[var(--color-text-muted)]">
              <span data-i18n="home.directExport">Direct vector export ready in studio</span>
            </span>
            <a 
              href="/generator" 
              class="font-mono text-xs font-semibold text-[var(--color-accent)] hover:underline flex items-center gap-1"
            >
              <span data-i18n="home.exportSvg">Export SVG</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Right: Secondary Formats Stack (Pills) -->
      <div class="flex flex-col gap-3.5 sm:gap-4 justify-between">
        {secondaryFormats.map((f) => (
          <div class="double-bezel-sm flex-1">
            <div class="double-bezel-sm-inner p-4 sm:p-5 md:p-6 flex flex-col justify-between h-full">
              <div class="flex items-center justify-between mb-2">
                <div class="flex items-center gap-2.5">
                  <span class="rounded-md bg-[var(--color-bg-panel)] px-2.5 py-1 font-mono text-xs font-bold text-[var(--color-text)] border border-[var(--color-border)]">
                    {f.ext}
                  </span>
                  <h4 data-i18n={f.titleKey} class="font-display font-semibold text-sm text-[var(--color-text)]">
                    {f.title}
                  </h4>
                </div>
                <span class="font-mono text-[10px] text-[var(--color-text-muted)] bg-[var(--color-bg-panel)] px-2 py-0.5 rounded-full border border-[var(--color-border-subtle)]">
                  <span data-i18n={f.badgeKey}>{f.badge}</span>
                </span>
              </div>

              <p class="text-body-sm text-[var(--color-text-secondary)] leading-relaxed my-2">
                <span data-i18n={f.descKey}>{f.desc}</span>
              </p>

              <div class="pt-3 border-t border-[var(--color-border-subtle)] font-mono text-[11px] text-[var(--color-text-muted)]">
                <span data-i18n="home.resolution">Resolution:</span> <span data-i18n={f.densityKey} class="text-[var(--color-text)]">{f.density}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
