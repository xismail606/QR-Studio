---
// QR Studio Premium Editorial Footer
---

<footer class="border-t border-[var(--color-border)] bg-[var(--color-bg-card)]/70 backdrop-blur-xl relative overflow-hidden transition-colors duration-300">
  <!-- Subtle ambient glow at top -->
  <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[var(--color-accent)]/50 to-transparent"></div>
  <div class="pointer-events-none absolute -top-24 left-1/2 -translate-x-1/2 w-96 h-48 bg-[var(--color-accent)]/5 blur-3xl rounded-full"></div>

  <div class="mx-auto max-w-page px-4 sm:px-6 py-12 sm:py-16">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 lg:gap-12">
      <!-- QR Studio Brand Section -->
      <div class="md:col-span-5 lg:col-span-4 space-y-4 text-left rtl:text-right">
        <div class="flex items-center gap-3">
          <a
            href="/"
            class="flex items-center gap-2.5 group"
            aria-label="QR Studio Home"
          >
            <div class="w-9 h-9 rounded-xl bg-[var(--color-bg-elevated)] border border-[var(--color-border-highlight)] flex items-center justify-center text-[var(--color-accent)] shadow-sm group-hover:scale-105 group-hover:border-[var(--color-accent)] group-hover:shadow-[0_0_15px_var(--color-accent-glow)] transition-all duration-300">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="18" height="18" x="3" y="3" rx="3" />
                <path d="M7 7h.01M17 7h.01M7 17h.01M12 7v4M7 12h4M12 17h5M17 12v5" />
              </svg>
            </div>
            <span class="font-display font-bold text-lg tracking-tight text-[var(--color-text)] group-hover:text-[var(--color-accent)] transition-colors" data-i18n="nav.brand">
              QR Studio
            </span>
          </a>
          <span class="rounded-full bg-[var(--color-accent-light)] px-2.5 py-0.5 font-mono text-[10px] font-semibold text-[var(--color-accent)] border border-[var(--color-accent)]/20">
            v2.4
          </span>
        </div>

        <p class="text-xs sm:text-sm text-[var(--color-text-secondary)] leading-relaxed max-w-sm" data-i18n="footer.desc">
          High-precision parametric QR code studio. Craft unique matrix styles, custom finder patterns, embedded brand marks, and export production-ready vector assets directly in your browser.
        </p>

        <!-- Privacy & Engine Status Pill -->
        <div class="pt-2">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border border-[var(--color-border-subtle)] bg-[var(--color-bg-panel)]/80 text-xs text-[var(--color-text-muted)]">
            <span class="w-2 h-2 rounded-full bg-[var(--color-success)] animate-pulse"></span>
            <span class="font-mono text-[11px]" data-i18n="footer.badge">100% In-Browser · Zero Telemetry</span>
          </div>
        </div>
      </div>

      <!-- Features Column -->
      <div class="md:col-span-2 lg:col-span-3 space-y-3 text-left rtl:text-right">
        <h3 class="font-mono text-xs uppercase tracking-wider font-semibold text-[var(--color-text)] flex items-center gap-1.5" data-i18n="footer.colFeatures">
          <span class="text-[var(--color-accent)]">#</span> Studio Features
        </h3>
        <ul class="space-y-2 text-xs">
          <li>
            <a
              href="/generator"
              class="text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] transition-colors flex items-center gap-1 group"
            >
              <span class="group-hover:translate-x-0.5 rtl:group-hover:-translate-x-0.5 transition-transform" data-i18n="footer.featGenerator">Parametric Generator</span>
            </a>
          </li>
          <li>
            <a
              href="/#templates"
              class="text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] transition-colors flex items-center gap-1 group"
            >
              <span class="group-hover:translate-x-0.5 rtl:group-hover:-translate-x-0.5 transition-transform" data-i18n="footer.featPresets">Curated Presets</span>
            </a>
          </li>
          <li>
            <a
              href="/generator"
              class="text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] transition-colors flex items-center gap-1 group"
            >
              <span class="group-hover:translate-x-0.5 rtl:group-hover:-translate-x-0.5 transition-transform" data-i18n="footer.featGeometry">Custom Eye & Dot Geometries</span>
            </a>
          </li>
          <li>
            <a
              href="/generator"
              class="text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] transition-colors flex items-center gap-1 group"
            >
              <span class="group-hover:translate-x-0.5 rtl:group-hover:-translate-x-0.5 transition-transform" data-i18n="footer.featLogos">Brand Logo Embedding</span>
            </a>
          </li>
          <li>
            <a
              href="/generator"
              class="text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] transition-colors flex items-center gap-1 group"
            >
              <span class="group-hover:translate-x-0.5 rtl:group-hover:-translate-x-0.5 transition-transform" data-i18n="footer.featScannability">Real-Time Scannability Audit</span>
            </a>
          </li>
          <li>
            <a
              href="/generator"
              class="text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] transition-colors flex items-center gap-1 group"
            >
              <span class="group-hover:translate-x-0.5 rtl:group-hover:-translate-x-0.5 transition-transform" data-i18n="footer.featFrames">Visual Call-to-Action Frames</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Export & Standards Column -->
      <div class="md:col-span-2 lg:col-span-2 space-y-3 text-left rtl:text-right">
        <h3 class="font-mono text-xs uppercase tracking-wider font-semibold text-[var(--color-text)] flex items-center gap-1.5" data-i18n="footer.colStandards">
          <span class="text-[var(--color-accent)]">#</span> Export & Standards
        </h3>
        <ul class="space-y-2 text-xs">
          <li>
            <a
              href="/#export"
              class="text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] transition-colors flex items-center gap-1 group"
            >
              <span class="group-hover:translate-x-0.5 rtl:group-hover:-translate-x-0.5 transition-transform" data-i18n="footer.stdSvg">Infinite Vector SVG</span>
            </a>
          </li>
          <li>
            <a
              href="/#export"
              class="text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] transition-colors flex items-center gap-1 group"
            >
              <span class="group-hover:translate-x-0.5 rtl:group-hover:-translate-x-0.5 transition-transform" data-i18n="footer.stdPng">Ultra-HD PNG (up to 4K)</span>
            </a>
          </li>
          <li>
            <a
              href="/#export"
              class="text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] transition-colors flex items-center gap-1 group"
            >
              <span class="group-hover:translate-x-0.5 rtl:group-hover:-translate-x-0.5 transition-transform" data-i18n="footer.stdWebp">Modern WebP Format</span>
            </a>
          </li>
          <li>
            <a
              href="/#features"
              class="text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] transition-colors flex items-center gap-1 group"
            >
              <span class="group-hover:translate-x-0.5 rtl:group-hover:-translate-x-0.5 transition-transform" data-i18n="footer.stdIso">ISO/IEC 18004 Standard</span>
            </a>
          </li>
          <li>
            <a
              href="/#features"
              class="text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] transition-colors flex items-center gap-1 group"
            >
              <span class="group-hover:translate-x-0.5 rtl:group-hover:-translate-x-0.5 transition-transform" data-i18n="footer.stdPrivacy">100% Client-Side Privacy</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Support & Community Column -->
      <div class="md:col-span-3 lg:col-span-3 space-y-3 text-left rtl:text-right">
        <h3 class="font-mono text-xs uppercase tracking-wider font-semibold text-[var(--color-text)] flex items-center gap-1.5" data-i18n="footer.colSupport">
          <span class="text-[var(--color-accent)]">#</span> Support & Community
        </h3>
        <ul class="space-y-2 text-xs">
          <li>
            <a
              href="/#how"
              class="text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] transition-colors flex items-center gap-1 group"
            >
              <span class="group-hover:translate-x-0.5 rtl:group-hover:-translate-x-0.5 transition-transform" data-i18n="footer.docs">Documentation & Guide</span>
            </a>
          </li>
          <li>
            <a
              href="https://github.com/xismail606"
              target="_blank"
              rel="noopener noreferrer"
              class="text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] transition-colors flex items-center gap-1 group"
            >
              <span class="group-hover:translate-x-0.5 rtl:group-hover:-translate-x-0.5 transition-transform" data-i18n="footer.reportBug">Report Bug / Issue</span>
            </a>
          </li>
          <li>
            <a
              href="https://github.com/xismail606"
              target="_blank"
              rel="noopener noreferrer"
              class="text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] transition-colors flex items-center gap-1 group"
            >
              <span class="group-hover:translate-x-0.5 rtl:group-hover:-translate-x-0.5 transition-transform" data-i18n="footer.developer">Developer Profile (x606)</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-6 border-t border-[var(--color-border)] flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[var(--color-text-muted)] text-center sm:text-left rtl:sm:text-right">
      <div class="font-mono text-[11px] sm:text-xs">
        <span data-i18n="footer.madeBy">Made by</span><span> </span>
        <a
          href="https://github.com/xismail606"
          target="_blank"
          rel="noopener noreferrer"
          class="font-semibold text-[var(--color-text)] hover:text-[var(--color-accent)] transition-colors underline decoration-[var(--color-border-highlight)] hover:decoration-[var(--color-accent)]"
        >
          x606
        </a>
        <span class="mx-1.5 text-[var(--color-border-highlight)]">|</span>
        <span data-i18n="footer.authorBio">Developer & Cybersecurity Specialist</span>
      </div>

      <div class="font-mono text-[11px]">
        &copy; 2026 QR Studio. <span data-i18n="footer.rights">All rights reserved.</span>
      </div>
    </div>
  </div>
</footer>
